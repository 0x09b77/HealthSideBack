# Copy to .env (gitignored) and fill in for local development.

# JWT signing secret (required in production).
JWT_SECRET=

# Claude API key for extraction/checkup (Anthropic). Never commit the real value.
LLM_API_KEY=

# Redis for the background job queue (extraction/checkup). Optional locally —
# without it uploads stay `pending` and you can trigger POST /documents/:id/extract.
REDIS_URL=redis://localhost:6379

# Resend API key for verification emails. Optional locally — without it the
# code is only logged, not sent (registration/login still work).
RESEND_API_KEY=

# Sender address for verification emails. Without a verified domain on the
# Resend account, this must stay the sandbox address (mail only reaches the
# account's own verified email).
MAIL_FROM=Healthside <onboarding@resend.dev>
